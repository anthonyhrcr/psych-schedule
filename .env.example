# Copy to .env.local and fill in from Supabase → Settings → API.
#
# Both values are public by design: they ship in the browser bundle, and row
# level security is what protects the data. Never put the service_role key
# here — it bypasses RLS entirely.
#
# Leave these unset and the app runs exactly as before, on this device only.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
